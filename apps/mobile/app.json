{
  "expo": {
    "name": "Season Challenger",
    "slug": "season-challenger",
    "owner": "svimran",
    "scheme": "seasonchallenger",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "updates": {
      "url": "https://u.expo.dev/7660cda2-2dd7-4681-9489-3279a6684438",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Season Challenger needs your photos so you can add pictures of your ID card or passport for the ID check.",
          "cameraPermission": "Season Challenger uses the camera to photograph your ID card or passport for the ID check.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#07080b"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.seasonchallenger.app"
    },
    "android": {
      "package": "com.seasonchallenger.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080b"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "7660cda2-2dd7-4681-9489-3279a6684438"
      }
    }
  }
}
